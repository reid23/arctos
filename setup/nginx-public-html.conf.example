# Example server-block locations. Review against the host's existing TLS,
# upload-size, API timeout, documentation and proxy configuration before use.
# This example uses the dev deploy root: FRONTEND_SERVER_ROOT=/var/www/html/
# stages the prepared bundle in /var/www/html/public. For production, the
# deploy workflow uses /var/www/reid/arctos/public instead. Set
# ARCTOS_FRONTEND_DIST in gunicorn to the same directory as the root below.
# Port 8081 is the Flask/gunicorn backend, not a frontend server. Configure
# gunicorn for plain HTTP on 127.0.0.1:8081 when nginx terminates TLS.
# This file intentionally installs no analytics or extra request logging.

location ^~ /assets/ {
    root /var/www/html/public;
    try_files $uri =404;
    types {
        application/wasm wasm;
        application/javascript js;
        text/css css;
        image/png png;
        image/svg+xml svg;
        font/woff2 woff2;
    }
    default_type application/octet-stream;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/wasm application/javascript text/css image/svg+xml;
    # Enable only if nginx -V shows http_gzip_static_module:
    # gzip_static on;
    # Dioxus assets (including their parent directories) are fingerprinted.
    # Do not copy mutable files into this immutable namespace.
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
}

# The Flask presentation endpoint compresses fixed CSS/JS once per worker and
# negotiates gzip with versioned browser caching. Keep this ahead of a generic
# static-file rule, or provide equivalent gzip/Vary/cache handling in that rule.
location ^~ /static/public/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache off;
}

# Keep existing /_api/, /api/, upload/waiver and docs proxy rules if they have
# special buffering or timeout settings. Public static assets may use the
# equivalent /static/ rule. Everything else is a Flask document decision now.
location / {
    proxy_pass http://127.0.0.1:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_cache off;
    # No try_files fallback to index.html: Flask must decide 200/404/503.
}
